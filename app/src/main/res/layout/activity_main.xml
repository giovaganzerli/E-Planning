<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#F6F7FB" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/header" android:orientation="horizontal" android:gravity="center_vertical" android:background="#172554" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:src="@drawable/ic_app_logo" android:background="@drawable/bg_app_icon" android:padding="8dp" android:contentDescription="@string/app_name" android:layout_width="46dp" android:layout_height="46dp" />
        <LinearLayout android:orientation="vertical" android:layout_marginStart="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/title" android:text="@string/header_title" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/subtitle" android:text="Il tuo planning, senza complicazioni" android:textColor="#BFDBFE" android:textSize="15sp" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageButton android:id="@+id/refresh" android:src="@drawable/ic_refresh" android:tint="#FFFFFF" android:contentDescription="Aggiorna dati ePlanning" android:background="@drawable/bg_logout" android:padding="9dp" android:layout_marginStart="6dp" android:layout_width="42dp" android:layout_height="42dp" />
        <ImageButton android:id="@+id/appMenu" android:src="@drawable/ic_menu" android:contentDescription="Apri menu" android:background="@drawable/bg_logout" android:padding="9dp" android:layout_marginStart="6dp" android:layout_width="42dp" android:layout_height="42dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/planningContainer" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_summary" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/previousPeriod" android:text="‹" android:textSize="24sp" android:textColor="#FFFFFF" android:background="@drawable/bg_period" android:layout_marginEnd="6dp" android:layout_width="36dp" android:layout_height="40dp" />
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                    <TextView android:id="@+id/weekLabel" android:text="La tua settimana" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/weekSummary" android:text="Accedi al portale e aggiorna" android:textColor="#DBEAFE" android:textSize="13sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/calendarSyncIndicator" android:textColor="#BBF7D0" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <Button android:id="@+id/nextPeriod" android:text="›" android:textSize="24sp" android:textColor="#FFFFFF" android:background="@drawable/bg_period" android:layout_marginStart="6dp" android:layout_width="36dp" android:layout_height="40dp" />
                <Button android:id="@+id/today" android:text="OGGI" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_period" android:layout_marginStart="6dp" android:layout_width="52dp" android:layout_height="40dp" />
                <ImageButton android:id="@+id/calendarSync" android:src="@drawable/ic_calendar_sync" android:contentDescription="Sincronizza settimana su Google Calendar" android:background="@drawable/bg_period" android:padding="8dp" android:visibility="gone" android:layout_marginStart="6dp" android:layout_width="40dp" android:layout_height="40dp" />
            </LinearLayout>
            <TextView android:id="@+id/status" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <ScrollView android:fillViewport="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp">
            <LinearLayout android:id="@+id/weekList" android:orientation="vertical" android:paddingBottom="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:id="@+id/bottomNavigation" android:gravity="center" android:orientation="horizontal" android:padding="8dp" android:background="#FFFFFF" android:elevation="8dp" android:layout_width="match_parent" android:layout_height="76dp">
        <Button android:id="@+id/openWeek" android:text="Settimana" android:textSize="11sp" android:textAllCaps="false" android:textColor="#1E40AF" android:drawableTop="@drawable/ic_nav_week" android:drawablePadding="2dp" android:gravity="center" android:background="@drawable/bg_nav_selected" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
        <Button android:id="@+id/openMonth" android:text="Mese" android:textSize="11sp" android:textAllCaps="false" android:textColor="#64748B" android:drawableTop="@drawable/ic_nav_month" android:drawablePadding="2dp" android:gravity="center" android:background="@drawable/bg_nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
        <Button android:id="@+id/openTeam" android:text="Squadra" android:textSize="11sp" android:textAllCaps="false" android:textColor="#64748B" android:drawableTop="@drawable/ic_nav_team" android:drawablePadding="2dp" android:gravity="center" android:background="@drawable/bg_nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
        <Button android:id="@+id/openSearch" android:text="Cerca cambio" android:textSize="11sp" android:textAllCaps="false" android:textColor="#64748B" android:drawableTop="@drawable/ic_nav_search" android:drawablePadding="2dp" android:gravity="center" android:background="@drawable/bg_nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
    </LinearLayout>
    <WebView android:id="@+id/portal" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
